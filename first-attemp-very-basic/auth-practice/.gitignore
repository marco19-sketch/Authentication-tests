cd C:\Git-repos\authentication

# Crea .gitignore con TUTTE le esclusioni necessarie
cat > .gitignore << 'EOF'
# Windows system files
desktop.ini
Thumbs.db
$RECYCLE.BIN/
*.lnk

# Node.js (CRITICAL - node_modules è enorme!)
node_modules/
.vite/
.vite-temp/
dist/
build/
.npm/
.yarn/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS metadata
.DS_Store
.AppleDouble
EOF